        "window_seconds": 60,
        "max_hits": 60
      },
      "per_pubkey": {
        "window_seconds": 60,
        "max_hits": 120
      },
      "per_group": {
        "window_seconds": 60,
        "max_hits": 120
      },
      "per_kind": {
        "window_seconds": 60,
