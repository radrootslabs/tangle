      "join_flow": {
        "window_seconds": 300,
        "max_hits": 10
      },
      "join_flow_per_ip": {
        "window_seconds": 300,
        "max_hits": 30
      }
    },
    "req": {
      "per_ip": {
        "window_seconds": 60,
        "max_hits": 600
      },
      "per_connection": {
        "window_seconds": 60,
        "max_hits": 120
      },
      "per_pubkey": {
        "window_seconds": 60,
        "max_hits": 240
